{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user in the app",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "coupleSpaceId": { "type": "string", "description": "ID of the shared couple space" },
        "mood": { "type": "string" },
        "loveLanguage": { "type": "string" },
        "permissionsGranted": { "type": "boolean" },
        "permissionsGrantedAt": { "type": "integer" }
      },
      "required": ["id", "email"]
    },
    "CoupleSpace": {
      "title": "Couple Space",
      "description": "A private space for two users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "partner1Id": { "type": "string" },
        "partner2Id": { "type": "string" },
        "inviteCode": { "type": "string" },
        "streak": { "type": "integer" },
        "lastInteractionAt": { "type": "integer", "description": "Timestamp" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "partner1Id", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message or reaction between partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "reaction", "surprise"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "senderId", "content", "type", "createdAt"]
    },
    "DailyQuestion": {
      "title": "Daily Question",
      "description": "Daily sync question for the couple",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "question": { "type": "string" },
        "date": { "type": "string" },
        "answer1": { "type": "string" },
        "answer1Id": { "type": "string" },
        "answer2": { "type": "string" },
        "answer2Id": { "type": "string" }
      },
      "required": ["id", "coupleSpaceId", "question", "date"]
    },
    "Memory": {
      "title": "Memory",
      "description": "A shared memory milestone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "creatorId": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "coupleSpaceId", "creatorId", "type", "content", "date"]
    },
    "Mood": {
      "title": "Mood",
      "description": "Daily mood entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "userId": { "type": "string" },
        "mood": { "type": "string" },
        "note": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "coupleSpaceId", "userId", "mood", "date"]
    },
    "LoveversePlayhouseGame": {
      "title": "Loveverse Playhouse Game State",
      "description": "Real-time state and turns for Loveverse Playhouse multiplayer games",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "gameType": { "type": "string" },
        "status": { "type": "string" },
        "currentTurn": { "type": "string" },
        "data": { "type": "string" },
        "scores": { "type": "string" },
        "round": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "gameType", "status", "updatedAt"]
    },
    "VisionBoardItem": {
      "title": "Shared Vision Board Item",
      "description": "A shared future dream, goal, or life vision item with photos and notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "targetYear": { "type": "string" },
        "completed": { "type": "boolean" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "creatorId", "creatorName", "category", "title", "createdAt", "updatedAt"]
    },
    "LoveCoupon": {
      "title": "Love Coupon & Date Reward",
      "description": "Unlockable and redeemable love coupons and date night wagers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tokenCost": { "type": "integer" },
        "emoji": { "type": "string" },
        "terms": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "gifted", "redeemed"] },
        "redeemedBy": { "type": "string" },
        "redeemedAt": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "creatorId", "creatorName", "title", "category", "tokenCost", "emoji", "status", "createdAt", "updatedAt"]
    },
    "UserWallet": {
      "title": "User Love Coins Wallet",
      "description": "Server-authoritative Love Coins balance and quota for an authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "balance": { "type": "integer" },
        "totalEarned": { "type": "integer" },
        "totalSpent": { "type": "integer" },
        "dailyEarnedToday": { "type": "integer" },
        "lastEarnDate": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "balance", "totalEarned", "totalSpent", "updatedAt"]
    },
    "CoinTransaction": {
      "title": "Coin Transaction",
      "description": "Immutable ledger record of earned or spent Love Coins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "integer" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "referenceId": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "userId", "amount", "type", "description", "createdAt"]
    },
    "UserInventory": {
      "title": "User Inventory",
      "description": "Owned themes, badges, and cosmetic perks unlocked with Love Coins",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "ownedThemes": { "type": "array", "items": { "type": "string" } },
        "activeTheme": { "type": "string" },
        "ownedBadges": { "type": "array", "items": { "type": "string" } },
        "equippedBadge": { "type": "string" },
        "ownedGamePacks": { "type": "array", "items": { "type": "string" } },
        "streakFreezeTokens": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "ownedThemes", "activeTheme", "updatedAt"]
    },
    "MissionSubmission": {
      "title": "Mission Proof Submission",
      "description": "Proof of romantic action analyzed and verified by AIRA for coin rewards",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "missionId": { "type": "string" },
        "proofType": { "type": "string" },
        "proofHash": { "type": "string" },
        "status": { "type": "string" },
        "coinsAwarded": { "type": "integer" },
        "airaEvaluation": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "userId", "coupleSpaceId", "missionId", "status", "createdAt"]
    },
    "VirtualGift": {
      "title": "Virtual Romantic Gift",
      "description": "Animated virtual gift sent to partner's chat using Love Coins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "giftId": { "type": "string" },
        "giftName": { "type": "string" },
        "cost": { "type": "integer" },
        "note": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "senderId", "giftId", "giftName", "cost", "createdAt"]
    },
    "TypingState": {
      "title": "Typing State",
      "description": "Real-time indicator showing if partner is actively typing in chat",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "isTyping": { "type": "boolean" },
        "userName": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["userId", "isTyping", "updatedAt"]
    },
    "LiveReaction": {
      "title": "Live Floating Reaction",
      "description": "Instant live heart reaction sent during couple chat session",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "type": { "type": "string" },
        "emoji": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["senderId", "type", "createdAt"]
    },
    "DigitalGift": {
      "title": "Digital Gift",
      "description": "Personalized digital gift experience for a partner in the couple space",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "coupleSpaceId": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "productId": { "type": "string" },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "status": { "type": "string" },
        "isPublicShare": { "type": "boolean" },
        "shareToken": { "type": "string" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "coupleSpaceId", "creatorId", "productId", "title", "createdAt", "updatedAt"]
    },
    "PublicDigitalGift": {
      "title": "Public Digital Gift",
      "description": "Public view-only representation of a digital gift accessible via unguessable share token",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shareToken": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "productId": { "type": "string" },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "isPublicShare": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "shareToken", "creatorId", "productId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/coupleSpaces/{spaceId}": {
      "schema": { "$ref": "#/entities/CoupleSpace" },
      "description": "Shared spaces for couples"
    },
    "/coupleSpaces/{spaceId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages within a couple space"
    },
    "/coupleSpaces/{spaceId}/dailyQuestions/{questionId}": {
      "schema": { "$ref": "#/entities/DailyQuestion" },
      "description": "Daily questions for a couple"
    },
    "/coupleSpaces/{spaceId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/Memory" },
      "description": "Memories timeline for a couple"
    },
    "/coupleSpaces/{spaceId}/moods/{moodId}": {
      "schema": { "$ref": "#/entities/Mood" },
      "description": "Mood tracking for a couple"
    },
    "/coupleSpaces/{spaceId}/playhouseGames/{gameId}": {
      "schema": { "$ref": "#/entities/LoveversePlayhouseGame" },
      "description": "Real-time synchronized game state for Loveverse Playhouse"
    },
    "/coupleSpaces/{spaceId}/visionBoard/{itemId}": {
      "schema": { "$ref": "#/entities/VisionBoardItem" },
      "description": "Shared vision board items for future goals, dreams, and plans"
    },
    "/coupleSpaces/{spaceId}/loveCoupons/{couponId}": {
      "schema": { "$ref": "#/entities/LoveCoupon" },
      "description": "Unlockable and redeemable love coupons and date rewards"
    },
    "/user_wallets/{userId}": {
      "schema": { "$ref": "#/entities/UserWallet" },
      "description": "Server-authoritative Love Coins balance for each user"
    },
    "/coin_transactions/{txId}": {
      "schema": { "$ref": "#/entities/CoinTransaction" },
      "description": "Transaction audit trail of earned and spent coins"
    },
    "/user_inventory/{userId}": {
      "schema": { "$ref": "#/entities/UserInventory" },
      "description": "Unlocked themes, badges, and cosmetic items"
    },
    "/mission_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/MissionSubmission" },
      "description": "Proof records evaluated by AIRA AI"
    },
    "/coupleSpaces/{spaceId}/virtualGifts/{giftId}": {
      "schema": { "$ref": "#/entities/VirtualGift" },
      "description": "Virtual romantic gifts triggered in the couple space"
    },
    "/coupleSpaces/{spaceId}/typing/{userId}": {
      "schema": { "$ref": "#/entities/TypingState" },
      "description": "Real-time indicator showing if partner is actively typing"
    },
    "/coupleSpaces/{spaceId}/reactions/{reactionId}": {
      "schema": { "$ref": "#/entities/LiveReaction" },
      "description": "Live floating reactions triggered during chat"
    },
    "/coupleSpaces/{spaceId}/digitalGifts/{giftId}": {
      "schema": { "$ref": "#/entities/DigitalGift" },
      "description": "Personalized digital gift experiences created within couple space"
    },
    "/public_digital_gifts/{shareToken}": {
      "schema": { "$ref": "#/entities/PublicDigitalGift" },
      "description": "Public shareable view-only digital gift documents"
    }
  }
}
